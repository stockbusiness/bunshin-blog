# BUNSHIN BLOG 環境変数
#
# このファイルをコピーして .env を作成する。
#   cp .env.example .env
#
# NEXT_PUBLIC_ が付かない変数は src/lib/env.ts で検証される。
# 未設定のまま起動すると、欠落した変数名を表示して起動が失敗する。
# NEXT_PUBLIC_ が付く変数はブラウザ向けで、起動時ではなく画面側で確認する。
#
# 変数は「それを使うタスク」で追加する。未実装機能の変数は先回りして
# 定義しない（LINE・WordPress・AI・Google連携の変数は各タスクで追加）。

# 実行環境。development / test / production のいずれか
# 未設定の場合は development として扱う
NODE_ENV=development

# PostgreSQL接続文字列（必須）
# prisma/schema.prisma の datasource が参照する
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunshin_blog

# LINE Login チャネルID（必須）
# LIFF の IDトークン検証に使う。LINE Developers コンソールで確認できる
# 数字のみ。チャネルシークレットではない
LINE_LOGIN_CHANNEL_ID=1234567890

# セッションCookieの署名鍵（必須・32文字以上）
# 環境ごとに別の値を使う。本番の値をリポジトリへ入れない
# 生成例: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# 保存データの暗号化キー（必須・base64の32バイト・C-1）
# WordPress の認証情報と Google の refresh token を AES-256-GCM で
# 暗号化する（SPEC 5.4・14.2、DATA_MODEL 7章）
#
# 生成: openssl rand -base64 32
#
# 鍵を変えると保存済みの値は復号できなくなる。モニターに接続をやり直して
# もらうことになるため、環境ごとに固定して管理する
ENCRYPTION_KEY=ZmFrZS1rZXktZm9yLWxvY2FsLWRldi0zMi1ieXRlcyE=

# LIFF ID（LIFF画面を開くのに必須・B-8）
# LINE Developers コンソールの LIFF アプリで発行する。形式は <数字>-<英数字>
#
# NEXT_PUBLIC_ で始まる変数は、ビルド時にブラウザ向けバンドルへ埋め込まれる。
# そのため src/lib/env.ts の起動時検証には含めない（起動時に見ても、
# 既に焼き付いた値を確認するだけで実際の失敗を防げない）。
# 未設定のままビルドすると、LIFF画面に設定漏れの案内が出る
NEXT_PUBLIC_LIFF_ID=1234567890-abcdefgh

# --- 管理者ログイン（B-11・OPEN_QUESTIONS Q-012／Q-013）---
#
# 以下3つは未設定でも起動する。LIFF側（モニターの利用）は動く必要があり、
# メールの設定漏れでサービス全体を止めない。管理者がログインを試みたときに
# 設定不足として扱う

# アプリの公開URL（管理者ログインに必須）
# メールに載せるリンクの組み立てに使う。
# リクエストの Host ヘッダーからは作らない。偽の Host を送られると
# リンクの向き先を攻撃者のドメインへ差し替えられる
APP_BASE_URL=http://localhost:3000

# Resend の APIキー（管理者ログインに必須）
# https://resend.com のダッシュボードで発行する
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 送信元アドレス（管理者ログインに必須）
# Resend でドメイン認証済みのものを使う
MAIL_FROM=BUNSHIN BLOG <noreply@example.com>

# ジョブワーカーの起動を認可する秘密（E-1）
# Vercel Cron が Authorization: Bearer <値> を付けて /api/jobs/run を叩く
#
# 未設定でも起動するが、**ワーカーは動かない**（fail closed）。
# cron の設定漏れでアプリ全体を止めないため、src/lib/env.ts の必須には
# 入れていない
#
# 生成: openssl rand -hex 32
#
# Vercel では、プロジェクトの環境変数に CRON_SECRET を設定すると
# Vercel Cron が自動でこのヘッダーを付ける
CRON_SECRET=change-me-to-a-random-hex-string
