# BUNSHIN BLOG 環境変数
#
# このファイルをコピーして .env を作成する。
#   cp .env.example .env
#
# ここに載っている変数は src/lib/env.ts で検証される。
# 未設定のまま起動すると、欠落した変数名を表示して起動が失敗する。
#
# 変数は「それを使うタスク」で追加する。未実装機能の変数は先回りして
# 定義しない（LINE・WordPress・AI・Google連携の変数は各タスクで追加）。

# 実行環境。development / test / production のいずれか
# 未設定の場合は development として扱う
NODE_ENV=development

# PostgreSQL接続文字列（必須）
# prisma/schema.prisma の datasource が参照する
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunshin_blog

# LINE Login チャネルID（必須）
# LIFF の IDトークン検証に使う。LINE Developers コンソールで確認できる
# 数字のみ。チャネルシークレットではない
LINE_LOGIN_CHANNEL_ID=1234567890

# セッションCookieの署名鍵（必須・32文字以上）
# 環境ごとに別の値を使う。本番の値をリポジトリへ入れない
# 生成例: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
