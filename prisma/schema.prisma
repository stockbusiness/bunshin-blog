model Approval {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  blogId           String         @map("blog_id") @db.Uuid
  contentItemId    String         @map("content_item_id") @db.Uuid
  /// 記事の版1つにつき提案は1つまで（F-1）。同じ版を二度提案しない
  articleVersionId String         @unique @map("article_version_id") @db.Uuid
  status           ApprovalStatus @default(PENDING)
  proposalType     ProposalType   @map("proposal_type")
  priorityScore    Int            @map("priority_score")
  proposalReason   String         @map("proposal_reason")
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz(6)
  viewedAt         DateTime?      @map("viewed_at") @db.Timestamptz(6)
  respondedAt      DateTime?      @map("responded_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog             Blog              @relation(fields: [blogId], references: [id], onDelete: Cascade)
  contentItem      ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
