/// 事実誤認の記録（TASKS J-7、OPEN_QUESTIONS Q-044、SPEC 16.2）。
///
/// **「承認・公開前に100%検知」を確かめるための分母。**
///
/// これまで記録されていたのは `article_versions.risk_flags` と
/// `unverified_claims`、つまり**機械が見つけたものだけ**だった。
/// **見逃したものはどこにも残らず、100%かどうかを言えなかった。**
///
/// **公開前に気づいたものも、公開後に見つかったものも、同じ表に入れる。**
/// 分けると、分母を組み立てるのに2か所を足し合わせることになり、
/// **片方を数え忘れたときに率が良く出る。**
model FactIssue {
  id                  String        @id @default(uuid()) @db.Uuid
  /// どの版の記事にあった誤りか。**記事ではなく版**（作り直せば直る）
  articleVersionId    String        @map("article_version_id") @db.Uuid
  /// SPEC 16.2 が見るのは「**重大な**事実誤認」。軽微なものと分ける
  severity            IssueSeverity
  /// 何が誤っていたか。**あとから読んで分かる長さで書く**
  description         String
  /// **公開前に気づいたか。** これが分子と分母を分ける唯一の列
  caughtBeforePublish Boolean       @map("caught_before_publish")
  /// いつ見つけたか。**記録した時刻ではない**（後からまとめて入れうる）
  foundAt             DateTime      @map("found_at") @db.Timestamptz(6)
  /// 誰が見つけたか。**分からなければ `null`**（読者からの指摘など）
  foundByUserId       String?       @map("found_by_user_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  articleVersion ArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  /// **見つけた人を消しても記録は残す。** 誤りがあった事実は消えない
  foundBy        User?          @relation(fields: [foundByUserId], references: [id], onDelete: SetNull)

  @@index([articleVersionId])
  @@index([caughtBeforePublish, severity])
  @@map("fact_issues")
}

enum IssueSeverity {
  MAJOR
  MINOR
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// 追加テーブル（SPEC 5章に記載なし・DATA_MODEL.mdに根拠を記載）
// ============================================================

/// 構成表生成の実行記録。STEP 1〜4の判定結果と再生成回数を保持する
model PlanningRun {
  id               String             @id @default(uuid()) @db.Uuid
  blogId           String             @map("blog_id") @db.Uuid
  contentPlanId    String?            @map("content_plan_id") @db.Uuid
  step1Status      PlanningStepStatus @map("step1_status")
  step1Reasons     Json               @map("step1_reasons")
  rejectionCount   Int                @default(0) @map("rejection_count")
  overriddenAt     DateTime?          @map("overridden_at") @db.Timestamptz(6)
  selectedOffers   Json               @map("selected_offers")
  retryCount       Int                @default(0) @map("retry_count")
  constraintResult Json               @map("constraint_result")
  succeeded        Boolean            @default(false)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  blog        Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  contentPlan ContentPlan? @relation(fields: [contentPlanId], references: [id], onDelete: SetNull)

  @@index([blogId, createdAt])
  @@map("planning_runs")
}

/// プロンプトのバージョン管理（SPEC 6.2 /admin/prompts の永続化先）
model PromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  version   String
  body      String
  isActive  Boolean  @default(false) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([key, version])
  @@index([key, isActive])
  @@map("prompt_versions")
}

/// アフィリエイトリンクの自前リダイレクタ（TASKS D-8）
model AffiliateLink {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  affiliateOfferId String   @map("affiliate_offer_id") @db.Uuid
  contentItemId    String?  @map("content_item_id") @db.Uuid
  /// 案件と記事が同じブログであることを強制するために持つ（D-11・Q-020）。
  ///
  /// `affiliate` から記事の持ち主を確かめると依存が循環するため
  /// （`content-planning → affiliate` が正）、**制約をDBへ置く**。C-6 と同じ形。
  blogId           String   @map("blog_id") @db.Uuid
  destinationUrl   String   @map("destination_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  affiliateOffer AffiliateOffer @relation(fields: [affiliateOfferId, blogId], references: [id, blogId], onDelete: Cascade)
  contentItem    ContentItem?   @relation(fields: [contentItemId, blogId], references: [id, blogId], onDelete: Cascade)
  clicks         LinkClick[]

  @@index([affiliateOfferId])
  @@index([blogId])
  @@map("affiliate_links")
}

/// クリック生イベント。日次で metrics_daily へ集計する
/// クリックの記録（D-8・D-12）。
///
/// **案件のリンクとバナーを同じ表で数える。** 別の表に分けると、
/// 「クリック」の数え方が2つになり、どちらが正しいのかを後から確かめられない。
///
/// **どちらか片方だけが入る**（CHECK 制約 `link_clicks_target_exactly_one`）。
/// 両方 NULL の行は何のクリックか分からず、両方入った行は二重に数えられる。
model LinkClick {
  id              String   @id @default(uuid()) @db.Uuid
  /// 送信元（WordPressのスニペット）が付ける識別子（D-12）。
  ///
  /// **再送で二重に数えないための鍵。** 送信に失敗したらWordPress側で保持し
  /// 次回まとめて送る（Q-001 再決定）ため、**応答だけが失われた場合に
  /// 同じクリックが2回届く。**
  ///
  /// `@unique` にして、2回目を落とす。D-8 の経路（Bunshin 側の
  /// リダイレクタ）で入った行は持たないので nullable
  eventId         String?  @unique @map("event_id")
  affiliateLinkId String?  @map("affiliate_link_id") @db.Uuid
  bannerId        String?  @map("banner_id") @db.Uuid
  referrerHost    String?  @map("referrer_host")
  isAiReferral    Boolean  @default(false) @map("is_ai_referral")
  userAgentHash   String?  @map("user_agent_hash")
  clickedAt       DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)

  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  banner        Banner?        @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId, clickedAt])
  @@index([bannerId, clickedAt])
  @@map("link_clicks")
}

/// ブログと Search Console のプロパティの対応（TASKS G-1、OPEN_QUESTIONS Q-030）。
///
/// **トークンを持たない。** 読み取りはサービスアカウント1つで行い、
/// その秘密鍵は `app_settings` の暗号化列に置く（Q-030）。モニターは
/// Search Console の「ユーザーと権限」でそのアドレスに権限を渡すため、
/// ブログごとの資格情報が存在しない。
///
/// ここが持つのは**どのプロパティを見るか**と、直近の取得の結果だけ。
model SearchConsoleConnection {
  id               String           @id @default(uuid()) @db.Uuid
  blogId           String           @unique @map("blog_id") @db.Uuid
  propertyUrl      String           @map("property_url")
  connectionStatus ConnectionStatus @default(UNTESTED) @map("connection_status")
  lastSyncedAt     DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  lastErrorCode    String?          @map("last_error_code")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("search_console_connections")
}

/// 管理画面から変更できる設定（TASKS H-7-schema、OPEN_QUESTIONS Q-017）。
///
/// **秘密は `value_encrypted` にしか入らない。** どちらの列に入るかは
/// `is_secret` と CHECK 制約で決まり、アプリ側の書き方に依存しない。
///
/// ここに置けるのは「アプリが動いた後で初めて要るもの」だけ。
/// `DATABASE_URL` や `ENCRYPTION_KEY` は環境変数のまま（Q-017）。
model AppSetting {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  /// 秘密でない値。`is_secret = true` のときは必ず NULL
  value           String?
  /// AES-256-GCM で暗号化した値。`is_secret = false` のときは必ず NULL
  valueEncrypted  String?  @map("value_encrypted")
  isSecret        Boolean  @default(false) @map("is_secret")
  /// 最後に変更した ADMIN。監査ログは `audit` モジュール未実装のため持たない
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("AppSettingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
