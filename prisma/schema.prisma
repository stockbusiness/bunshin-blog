/// 構成表生成の実行記録。STEP 1〜4の判定結果と再生成回数を保持する
model PlanningRun {
  id               String             @id @default(uuid()) @db.Uuid
  blogId           String             @map("blog_id") @db.Uuid
  contentPlanId    String?            @map("content_plan_id") @db.Uuid
  step1Status      PlanningStepStatus @map("step1_status")
  step1Reasons     Json               @map("step1_reasons")
  rejectionCount   Int                @default(0) @map("rejection_count")
  overriddenAt     DateTime?          @map("overridden_at") @db.Timestamptz(6)
  selectedOffers   Json               @map("selected_offers")
  retryCount       Int                @default(0) @map("retry_count")
  constraintResult Json               @map("constraint_result")
  succeeded        Boolean            @default(false)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  blog        Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  contentPlan ContentPlan? @relation(fields: [contentPlanId], references: [id], onDelete: SetNull)

  @@index([blogId, createdAt])
  @@map("planning_runs")
}

/// プロンプトのバージョン管理（SPEC 6.2 /admin/prompts の永続化先）
model PromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  version   String
  body      String
  isActive  Boolean  @default(false) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([key, version])
  @@index([key, isActive])
  @@map("prompt_versions")
}

/// アフィリエイトリンクの自前リダイレクタ（TASKS D-8）
model AffiliateLink {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  affiliateOfferId String   @map("affiliate_offer_id") @db.Uuid
  contentItemId    String?  @map("content_item_id") @db.Uuid
  destinationUrl   String   @map("destination_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  affiliateOffer AffiliateOffer @relation(fields: [affiliateOfferId], references: [id], onDelete: Cascade)
  contentItem    ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  clicks         LinkClick[]

  @@index([affiliateOfferId])
  @@map("affiliate_links")
}

/// クリック生イベント。日次で metrics_daily へ集計する
model LinkClick {
  id              String   @id @default(uuid()) @db.Uuid
  affiliateLinkId String   @map("affiliate_link_id") @db.Uuid
  referrerHost    String?  @map("referrer_host")
  isAiReferral    Boolean  @default(false) @map("is_ai_referral")
  userAgentHash   String?  @map("user_agent_hash")
  clickedAt       DateTime @default(now()) @map("clicked_at") @db.Timestamptz(6)

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId, clickedAt])
  @@map("link_clicks")
}

/// Search Console の OAuth トークン（TASKS G-1）
model SearchConsoleConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  blogId                String           @unique @map("blog_id") @db.Uuid
  propertyUrl           String           @map("property_url")
  refreshTokenEncrypted String           @map("refresh_token_encrypted")
  connectionStatus      ConnectionStatus @default(UNTESTED) @map("connection_status")
  lastSyncedAt          DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  lastErrorCode         String?          @map("last_error_code")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("search_console_connections")
}
