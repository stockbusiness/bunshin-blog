// BUNSHIN BLOG Phase 0 — Prisma schema
// 対応仕様：docs/SPEC.md v2.1 第5章
// 補足：docs/DATA_MODEL.md（jsonb構造・アプリ層制約・追加テーブルの根拠）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  MONITOR
}

enum UserStatus {
  INVITED
  ACTIVE
  PAUSED
  WITHDRAWN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BlogPurpose {
  AFFILIATE
  DISPLAY_AD
  MIXED
}

enum BlogStatus {
  SETUP
  ACTIVE
  PAUSED
  CLOSED
}

/// 分身の種類（ROADMAP 2章、TASKS A-2-R-1）
enum PersonaType {
  /// 本人に近い人格
  SELF
  /// なりたい姿
  IDEAL
  /// 作り込んだ別人格
  CHARACTER
}

/// 分身の状態。`ACTIVE` の数が段階解放の対象になる（ROADMAP 5章）
enum PersonaStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ConnectionStatus {
  UNTESTED
  CONNECTED
  FAILED
  REVOKED
}

enum CompetitionLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum YmylRisk {
  HIGH
  MEDIUM
  LOW
}

enum GenreStatus {
  CANDIDATE
  APPROVED
  REJECTED
}

enum FactType {
  EXPERIENCE
  OPINION
  PROFILE
  FAILURE
  PRODUCT_REVIEW
}

enum FactSource {
  USER_INPUT
  ADMIN_INTERVIEW
  EXISTING_CONTENT
  AI_INFERENCE
}

enum FactVerification {
  VERIFIED
  UNVERIFIED
  REJECTED
}

enum ConversionType {
  FREE_SIGNUP
  REQUEST
  TRIAL
  PURCHASE
  OTHER
}

enum UserExperience {
  USED
  NOT_USED
  UNKNOWN
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  NEEDS_REVIEW
}

/// 記事本文へ埋めるアフィリエイトリンクの出し方（D-9・OPEN_QUESTIONS Q-001）。
///
/// ASPによって、別ドメインのリダイレクタ経由の掲載を許すところと
/// 許さないところがある。方式を1つに決めず、案件ごとに持つ。
///
/// - REDIRECT: 自前の `/go/<code>` を経由する。クリックを正確に数えられる
/// - DIRECT:   `affiliate_url` をそのまま貼る。クリックは数えられない
///
/// **既定は DIRECT（安全側）。** 規約を確認できたASPだけ REDIRECT へ上げる。
/// 判断がつかないものを許可側へ倒すと、成果が無効になったときに
/// 取り返しがつかない。
enum LinkMode {
  REDIRECT
  DIRECT
}

/**
 * WordPress のパーマリンク様式（TASKS C-9、作業指示書 W-8）。
 * **4つから選ぶ。** 自由文字列にすると、`%postname%` の綴り違いのような
 * 打ち間違いが実際のブログの設定と食い違ったまま残る。
 * **スラッグは英数字にする。** 日本語スラッグはURLエンコードで長大になり、
 * 共有されたときに読めない。
 */
enum PermalinkPattern {
  /// `/%postname%/`
  POSTNAME
  /// `/%category%/%postname%/`
  CATEGORY_POSTNAME
  /// `/blog/%postname%/`
  BLOG_POSTNAME
  /// `/archives/%post_id%/`
  ARCHIVES_POST_ID
}

enum BannerSlot {
  TOP
  AFTER_FIRST_HEADING
  MIDDLE
  BOTTOM
  SIDEBAR
}

enum BannerStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum StrategyType {
  STANDARD
  HIGH_VOLUME
  HIGH_QUALITY
  REVENUE_FOCUSED
  CUSTOM
}

enum PlanType {
  INITIAL
  MONTHLY
  AD_HOC
}

enum PlanStatus {
  DRAFT
  APPROVED
  ACTIVE
  ARCHIVED
}

enum ContentType {
  INFORMATIONAL
  EXPERIENCE
  FAQ
  COMPARISON
  AFFILIATE
}

enum Objective {
  TRAFFIC
  TRUST
  REVENUE
  INTERNAL_LINK
}

enum ContentItemStatus {
  PLANNED
  GENERATING
  READY_FOR_REVIEW
  APPROVED
  POSTED
  PUBLISHED
  REJECTED
}

enum FactCheckStatus {
  NOT_CHECKED
  PASSED
  WARNING
  FAILED
}

enum ApprovalStatus {
  PENDING
  VIEWED
  APPROVED
  REVISION_REQUESTED
  SKIPPED
  EXPIRED
}

enum ProposalType {
  NEW_ARTICLE
  REWRITE
  TITLE
  CTA
  INTERNAL_LINK
  BANNER
}

enum RevisionRequestType {
  SHORTER
  SOFTER
  CHANGE_TITLE
  CHANGE_PRODUCT
  FACT_ERROR
  FREE_TEXT
}

enum WpPostStatus {
  DRAFT
  PENDING
  PUBLISH
  TRASH
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PlanningStepStatus {
  PASSED
  WARNED
  BLOCKED
  OVERRIDDEN
}

// ============================================================
// ユーザー
// ============================================================

model User {
  id               String     @id @default(uuid()) @db.Uuid
  role             Role       @default(MONITOR)
  displayName      String     @map("display_name")
  email            String?    @unique
  lineUserId       String?    @unique @map("line_user_id")
  status           UserStatus @default(INVITED)
  timezone         String     @default("Asia/Tokyo")
  /// ADMINが参加を認めた時刻（OPEN_QUESTIONS Q-034、H-1）。
  ///
  /// **`created_at` では代用できない。** 登録しただけでは `INVITED` のままで
  /// アプリを使えず、承認までは何も始まらない。承認待ちが長い人ほど
  /// 早く枠が開いてしまう。
  ///
  /// ここを起点にするもの：
  /// - 分身の段階解放（ROADMAP 5章。1〜30日は1体、31〜60日は2体、61〜90日は3体）
  /// - 90日検証の期間（ROADMAP 4章）
  /// - 8週間継続率（SPEC 11.1）
  ///
  /// **最初の1回だけ入れる。** 停止して再開しても動かさない
  /// （動くと3つとも数え方が変わる）。
  activatedAt      DateTime?  @map("activated_at") @db.Timestamptz(6)
  termsAcceptedAt  DateTime?  @map("terms_accepted_at") @db.Timestamptz(6)
  dataUseConsentAt DateTime?  @map("data_use_consent_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  monitorProfile MonitorProfile?
  personas       Persona[]
  blogs          Blog[]
  approvals      Approval[]
  aiUsageLogs    AiUsageLog[]
  auditLogs      AuditLog[]        @relation("AuditActor")
  loginTokens    AdminLoginToken[]
  appSettings    AppSetting[]      @relation("AppSettingEditor")
  factIssues     FactIssue[]

  @@index([status])
  @@map("users")
}

/// 管理者のログイン用ワンタイムトークン（B-10、OPEN_QUESTIONS Q-012）。
/// **トークンそのものは保存しない。** ハッシュだけを持つ。
model AdminLoginToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("admin_login_tokens")
}

model MonitorProfile {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String           @unique @map("user_id") @db.Uuid
  affiliateExperienceYears Int?             @map("affiliate_experience_years")
  monthlyGoalYen           Int?             @map("monthly_goal_yen")
  primaryAspNames          String[]         @map("primary_asp_names")
  notificationDays         Int[]            @map("notification_days")
  notificationTime         DateTime         @map("notification_time") @db.Time(6)
  maxDailyProposals        Int              @default(1) @map("max_daily_proposals")
  onboardingStatus         OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("monitor_profiles")
}

// ============================================================
// ブログ
// ============================================================

model Blog {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @map("user_id") @db.Uuid
  name                   String
  slug                   String
  genreId                String?          @map("genre_id") @db.Uuid
  /// どの分身の媒体か。**ブログは分身の媒体である**（A-2-R-3 で必須にした）。
  ///
  /// **`Restrict`。** 分身を消してもブログを道連れにしない。
  ///
  /// **参照は `(persona_id, user_id)` の複合外部キー**（A-2-R-2c-schema）。
  /// 他人の分身IDを紐づけられなくする。D-11 の
  /// `affiliate_links` とまったく同じ形で、理由も同じ —
  /// **依存の向きが `personas → blogs` なので、`blogs` から
  /// 分身の持ち主を確かめられない**（MODULE_RULES 3）
  personaId              String           @map("persona_id") @db.Uuid
  penName                String?          @map("pen_name")
  targetReader           String           @map("target_reader")
  purpose                BlogPurpose      @default(AFFILIATE)
  status                 BlogStatus       @default(SETUP)
  slotNumber             Int              @map("slot_number")
  launchDate             DateTime?        @map("launch_date") @db.Date
  articleRatio           Json             @map("article_ratio")
  experimentGroupId      String?          @map("experiment_group_id") @db.Uuid
  /// クリック受信API（D-12）の認証。**ハッシュだけを持つ。**
  ///
  /// Bunshin は照合しかしないので、原文を持つ理由が無い。DBを読めた相手が
  /// 他ブログのイベントを投入できるようにしない（`admin_login_tokens` と同じ）。
  ///
  /// **`@unique`。** 受信APIはこの1列でブログを引く — トークンが
  /// ブログを決めるので、他ブログのイベントを名乗れない
  linkEventTokenHash     String?          @unique @map("link_event_token_hash")
  /// いつ発行したか。**原文は二度と出せない**ので、画面はこれで「発行済み」を示す
  linkEventTokenIssuedAt DateTime?        @map("link_event_token_issued_at") @db.Timestamptz(6)
  /// 公開する曜日（0=日〜6=土）。**ブログごとに散らす**（C-9）。
  ///
  /// **空にできない**（`blogs_publish_weekdays_not_empty`・C-9-schema-3）。
  /// 空の配列はどの曜日にも当たらないので、**時刻があっても一度も
  /// 公開されない。** ブログは `ACTIVE` のまま記事だけが溜まる
  publishWeekdays        Int[]            @map("publish_weekdays")
  /// 公開時刻（JSTの壁掛け時計）。`time` 型にUTCへ直さずそのまま入れる。
  ///
  /// **必須**（C-9-schema-2）。空だと投稿ジョブから見て「いつ公開するか
  /// 決まっていない」ことになり、読む側が必ず既定値を持つ。
  ///
  /// **既定値は置かない。** 置くと、**割り当てを忘れた行が
  /// 「9時のブログ」として紛れる。** 落とすなら保存の時点で落とす
  publishTime            DateTime         @map("publish_time") @db.Time(6)
  /// 実行時刻のゆらぎ（分）。**全ブログの投稿ジョブを同一時刻に集中させない**
  publishJitterMin       Int              @default(0) @map("publish_jitter_min")
  /// WordPress のパーマリンク様式。**初回設定後に変更しない**
  ///
  /// 変えるとURLが全部変わり、**それまでの被リンクと評価が切れる。**
  /// 必要になったらリダイレクトを伴う別タスクで扱う（W-8）
  permalinkPattern       PermalinkPattern @default(POSTNAME) @map("permalink_pattern")
  /// 初期記事数（28〜34）。**ブログごとに散らす**
  initialArticleCount    Int              @default(30) @map("initial_article_count")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  genre           Genre?                   @relation(fields: [genreId], references: [id], onDelete: SetNull)
  persona         Persona                  @relation(fields: [personaId, userId], references: [id, userId], onDelete: Restrict)
  experimentGroup ExperimentGroup?         @relation(fields: [experimentGroupId], references: [id], onDelete: SetNull)
  wordpress       WordpressConnection?
  personaSettings BlogPersonaSetting?
  searchConsole   SearchConsoleConnection?
  offers          AffiliateOffer[]
  banners         Banner[]
  contentPlans    ContentPlan[]
  contentItems    ContentItem[]
  wordpressPosts  WordpressPost[]
  approvals       Approval[]
  metricsDaily    MetricDaily[]
  planningRuns    PlanningRun[]
  aiUsageLogs     AiUsageLog[]

  @@unique([userId, slotNumber])
  @@index([userId, status])
  @@map("blogs")
}

model WordpressConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  blogId               String           @unique @map("blog_id") @db.Uuid
  siteUrl              String           @map("site_url")
  wpUsernameEncrypted  String           @map("wp_username_encrypted")
  appPasswordEncrypted String           @map("app_password_encrypted")
  apiBaseUrl           String           @map("api_base_url")
  connectionStatus     ConnectionStatus @default(UNTESTED) @map("connection_status")
  canCreatePosts       Boolean          @default(false) @map("can_create_posts")
  canEditPosts         Boolean          @default(false) @map("can_edit_posts")
  canUploadMedia       Boolean          @default(false) @map("can_upload_media")
  lastTestedAt         DateTime?        @map("last_tested_at") @db.Timestamptz(6)
  lastSyncedAt         DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  lastErrorCode        String?          @map("last_error_code")
  lastErrorMessage     String?          @map("last_error_message")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("wordpress_connections")
}

model Genre {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  category         String
  competitionLevel CompetitionLevel @default(UNKNOWN) @map("competition_level")
  ymylRisk         YmylRisk         @map("ymyl_risk")
  notes            String?
  status           GenreStatus      @default(CANDIDATE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  blogs Blog[]

  @@unique([name])
  @@map("genres")
}

// ============================================================
// 分身
// ============================================================

/// 分身（TASKS A-2-R-1、ROADMAP 2章）。
///
/// **1ユーザーが複数持てる。** `user_personas` が1ユーザー1件だったのを
/// 改めるもので、事業計画の「分身が主、媒体が従」に合わせる。
///
/// **`user_personas` は A-2-R-3 まで残る。** いま消すと参照している20ファイルが
/// 一斉に壊れ、CIが赤のままになる（OPEN_QUESTIONS Q-033）。
/// 移行が済むまでの並存であり、恒久的な二重管理ではない。
///
/// jsonb の4つは「6つの頭脳」のうち記憶と成長を除いたもの。
/// **記憶は `persona_facts` と記事履歴、成長は `metrics_daily` で代替する**
/// （専用テーブルを作らない）。
model Persona {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String
  personaType PersonaType   @map("persona_type")
  /// 名前・性格・価値観・文体・禁止表現
  identity    Json
  /// 専門領域・情報源・評価基準
  expertise   Json
  /// 読者像・悩み・検索意図
  audience    Json
  /// 収益方針・目標・KPI・撤退条件
  business    Json
  status      PersonaStatus @default(DRAFT)
  /// 段階解放の起点（ROADMAP 5章）。`ACTIVE` になった時刻
  activatedAt DateTime?     @map("activated_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogs        Blog[]
  personaFacts PersonaFact[]

  /// `blogs` からの複合外部キーの参照先（A-2-R-2c-schema）。
  /// `id` 単独でも一意なので、制約としては冗長
  @@unique([id, userId])
  @@index([userId, status])
  @@map("personas")
}

model BlogPersonaSetting {
  id           String   @id @default(uuid()) @db.Uuid
  blogId       String   @unique @map("blog_id") @db.Uuid
  penName      String   @map("pen_name")
  toneOverride Json     @map("tone_override")
  ngTopics     String[] @map("ng_topics")
  writingRules Json     @map("writing_rules")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("blog_persona_settings")
}

/// 分身の記憶（TASKS A-2-R-2）。
///
/// **記憶は媒体ではなく人格に溜まる。** 同じ分身が将来べつの媒体へ広がっても
/// 記憶を引き継げるようにするため、所属を `personas` へ移す。
///
/// `user_id` と `blog_id` は **A-2-R-3 で落とす。** いま消すと参照している
/// コードが一斉に壊れるため、移行のあいだだけ並存させる（Q-033）。
model PersonaFact {
  id                String           @id @default(uuid()) @db.Uuid
  /// どの分身の記憶か（A-2-R-4-schema で必須にした）。
  ///
  /// **記憶は媒体ではなく人格に溜まる。** 同じ分身が将来べつの媒体
  /// （SNS・動画）へ広がっても引き継げるようにする。
  ///
  /// **`Cascade`。** 分身を消せばその記憶も消える（人格に属するものだから）
  personaId         String           @map("persona_id") @db.Uuid
  factType          FactType         @map("fact_type")
  content           String
  source            FactSource
  verification      FactVerification @default(UNVERIFIED)
  usableFirstPerson Boolean          @default(false) @map("usable_first_person")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, verification])
  @@map("persona_facts")
}

// ============================================================
// 案件・バナー
// ============================================================

model AffiliateOffer {
  id                    String         @id @default(uuid()) @db.Uuid
  blogId                String         @map("blog_id") @db.Uuid
  name                  String
  aspName               String         @map("asp_name")
  advertiserName        String?        @map("advertiser_name")
  landingPageUrl        String         @map("landing_page_url")
  affiliateUrl          String         @map("affiliate_url")
  rewardYen             Int?           @map("reward_yen")
  conversionType        ConversionType @map("conversion_type")
  facts                 Json
  /// 事実（報酬・条件・キャンペーン）を**確かめ直した**時刻
  /// （D-13-schema・Q-022）。CONTENT_PLANNING 8.2 の90日判定が読む。
  ///
  /// **`updated_at` では代用できない。** あちらは行のどの列を変えても
  /// 更新されるので、状態を `ACTIVE` にしただけで
  /// 「事実を確かめ直した」ことになってしまう。
  ///
  /// **NULL は「一度も確かめていない」。** 既定値を入れない —
  /// 入れると、確かめていない案件が「今日確かめた」ことになり、
  /// **古い価格が「確認済み」として公開される。**
  /// 書くのは `facts` を実際に変えた経路だけ（D-13）
  factsUpdatedAt        DateTime?      @map("facts_updated_at") @db.Timestamptz(6)
  userExperience        UserExperience @default(UNKNOWN) @map("user_experience")
  userRating            Int?           @map("user_rating")
  denyConditions        String[]       @map("deny_conditions")
  /// リンクを最後に確かめた時刻（H-3b-schema・Q-029）。**通っていても入る。**
  ///
  /// **`NULL` は「一度も確かめていない」。** 古ければ
  /// 「確認できていない」であって「問題なし」ではない
  linkCheckedAt         DateTime?      @map("link_checked_at") @db.Timestamptz(6)
  /// **切れていると分かった最初の時刻**（H-3b-schema・Q-029）。
  ///
  /// 切れている間は**動かさない** — 動かすと「いつからか」が毎回今日になり、
  /// モニターが直す優先度を決められない。直ったら `NULL` に戻す。
  ///
  /// **一時的な失敗（401/403/5xx）では入れない。** 404/410 だけを
  /// 「消えた」とする（H-3 と同じ扱い）
  linkBrokenAt          DateTime?      @map("link_broken_at") @db.Timestamptz(6)
  lpFormFields          Int?           @map("lp_form_fields")
  lpMobileReady         Boolean?       @map("lp_mobile_ready")
  /// LPのページ長（取得したHTMLのバイト数・D-2）。
  ///
  /// SPEC 9.2.3 が「ページ長を機械判定する」と定めているが、スコアにも
  /// 足切りにも使われない。**判定した値を残さないと、後から
  /// 「なぜこの案件が落ちたのか」を確かめられない。**
  lpContentLength       Int?           @map("lp_content_length")
  lpEvaluatedAt         DateTime?      @map("lp_evaluated_at") @db.Timestamptz(6)
  selectionScore        Int?           @map("selection_score")
  scoreBreakdown        Json?          @map("score_breakdown")
  status                OfferStatus    @default(DRAFT)
  /// リンクの出し方。既定は DIRECT（安全側・Q-001）
  linkMode              LinkMode       @default(DIRECT) @map("link_mode")
  /// サブIDのパラメータ名（D-10・OPEN_QUESTIONS Q-014）。
  ///
  /// ASPによって名前が違う（sub / s1 / argument など）。
  /// **NULL ならサブIDを付けない。** ASPの情報が無くても案件は登録でき、
  /// 分かったものから ADMIN が SQL で埋める。
  subIdParam            String?        @map("sub_id_param")
  /// ブログへの掲載が禁じられているか（E-5-schema・OPEN_QUESTIONS Q-019）。
  ///
  /// SPEC 9.2.3 の足切りの1つ。**ASPの規約の判断**なので ADMIN が設定する
  /// （`link_mode` `sub_id_param` と同じ扱い）。既定は `false`。
  /// `deny_conditions` の文言から機械判定しない — 表記が揺れ、
  /// **黙って通す/黙って落とすのどちらも起きる。**
  blogPostingProhibited Boolean        @default(false) @map("blog_posting_prohibited")
  startsAt              DateTime?      @map("starts_at") @db.Date
  endsAt                DateTime?      @map("ends_at") @db.Date
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog           Blog            @relation(fields: [blogId], references: [id], onDelete: Cascade)
  banners        Banner[]
  contentItems   ContentItem[]
  affiliateLinks AffiliateLink[]

  // `affiliate_links` が `(affiliate_offer_id, blog_id)` の組で参照するために要る（D-11）。
  // `id` は単独でも一意なので、制約としては冗長。参照先の要件で置く
  @@unique([id, blogId])
  @@index([blogId, status])
  @@map("affiliate_offers")
}

model Banner {
  id               String       @id @default(uuid()) @db.Uuid
  blogId           String       @map("blog_id") @db.Uuid
  /// `/go/{code}` を通すためのコード（D-12）。**バナーも案件と同じ経路で数える。**
  ///
  /// 別の経路を作ると、クリックの数え方が2つになり、
  /// どちらが正しいのかを後から確かめられなくなる
  code             String       @unique
  name             String
  imageUrl         String       @map("image_url")
  destinationUrl   String       @map("destination_url")
  affiliateOfferId String?      @map("affiliate_offer_id") @db.Uuid
  slot             BannerSlot
  targetCategories String[]     @map("target_categories")
  status           BannerStatus @default(ACTIVE)
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog           Blog            @relation(fields: [blogId], references: [id], onDelete: Cascade)
  affiliateOffer AffiliateOffer? @relation(fields: [affiliateOfferId], references: [id], onDelete: SetNull)
  clicks         LinkClick[]

  @@index([blogId, status])
  @@map("banners")
}

