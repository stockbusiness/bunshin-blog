model WordpressPost {
  id              String       @id @default(uuid()) @db.Uuid
  blogId          String       @map("blog_id") @db.Uuid
  contentItemId   String       @unique @map("content_item_id") @db.Uuid
  wpPostId        Int          @map("wp_post_id")
  wpPostUrl       String?      @map("wp_post_url")
  wpEditUrl       String?      @map("wp_edit_url")
  wpStatus        WpPostStatus @default(DRAFT) @map("wp_status")
  lastContentHash String       @map("last_content_hash")
  postedAt        DateTime     @map("posted_at") @db.Timestamptz(6)
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(6)
  lastSyncedAt    DateTime?    @map("last_synced_at") @db.Timestamptz(6)
  userEditedAt    DateTime?    @map("user_edited_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  blog        Blog        @relation(fields: [blogId], references: [id], onDelete: Cascade)
  // **`blog_id` と `content_item_id` の組で参照する**（C-6）。
  // 単独の参照では、他人の `content_item_id` を自分のブログの投稿に
  // 結び付けられる（`content_item_id` は unique なので、相手はその記事を
  // 二度と投稿できなくなる）
  contentItem ContentItem @relation(fields: [contentItemId, blogId], references: [id, blogId], onDelete: Cascade)

  @@unique([blogId, wpPostId])
  // 1対1関係の定義側として要る。`content_item_id` 単独の unique があるため
  // 制約としては冗長だが、複合参照を1対1のまま保つのに必要
  @@unique([contentItemId, blogId])
  @@map("wordpress_posts")
}

